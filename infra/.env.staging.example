# Copy to infra/.env.staging and fill in. Never commit .env.staging.

POSTGRES_USER=davart
POSTGRES_PASSWORD=replace-with-long-random
POSTGRES_DB=davart

MEILI_MASTER_KEY=replace-with-64-char-random
JWT_SECRET=replace-with-at-least-32-char-random

# Public origins of CRM / web (comma-separated). Required in production.
CORS_ORIGIN=https://crm.example.com

S3_ACCESS_KEY=davart
S3_SECRET_KEY=replace-with-minio-secret
S3_BUCKET=davart
# Public URL phones can reach (https://files.example.com/davart)
S3_PUBLIC_BASE_URL=https://files.example.com/davart

SMS_PROVIDER=mock
# SMSRU_API_ID=

# Не нужен для работы чата в РФ. FCM часто недоступен без VPN — не задавайте.
# FCM_SERVER_KEY=
# SENTRY_DSN=

# Cloudflare Tunnel token (Zero Trust → Tunnels → Docker). Never commit.
# CLOUDFLARE_TUNNEL_TOKEN=
