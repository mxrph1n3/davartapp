# Copy to infra/.env.staging and fill in. Never commit .env.staging.

POSTGRES_USER=davart
POSTGRES_PASSWORD=replace-with-long-random
POSTGRES_DB=davart

MEILI_MASTER_KEY=replace-with-64-char-random
JWT_SECRET=replace-with-at-least-32-char-random

# Public origins of CRM / web (comma-separated). Required in production.
CORS_ORIGIN=https://crm.example.com

S3_ACCESS_KEY=davart
S3_SECRET_KEY=replace-with-minio-secret
S3_BUCKET=davart
# Public URL phones can reach (https://files.example.com/davart)
S3_PUBLIC_BASE_URL=https://files.example.com/davart

# OTP: SMS only (targetsms | smsru | p1sms | mock)
SMS_PROVIDER=targetsms
SMS_FALLBACK_PROVIDER=targetsms
# Demo / App Review: login without SMS
# Client-only demo account for App Review; pick a random 4-digit code, never 0000.
# AUTH_TEST_PHONES=
# AUTH_TEST_CODE=
# SMSRU_API_ID=
# TARGETSMS_LOGIN=
# TARGETSMS_PASSWORD=
# TARGETSMS_SENDER=DAVart.ru


# iOS push. SMS is only for the login code.
# Put the .p8 in infra/apns/AuthKey.p8 (never commit it) and set the Key ID.
# APNS_KEY_ID=
# APNS_TEAM_ID=C7968P6K9R
# APNS_BUNDLE_ID=com.davart.app
# APNS_KEY_PATH=/etc/davart/AuthKey.p8
# FCM_SERVER_KEY=
# SENTRY_DSN=

# Cloudflare Tunnel token (Zero Trust → Tunnels → Docker). Never commit.
# CLOUDFLARE_TUNNEL_TOKEN=

# Чат «Заказы» в приложении: id группового чата и служебного отправителя (участник чата)
ORDERS_CHAT_ID=
ORDERS_CHAT_SENDER_ID=
