# PostgreSQL
DATABASE_URL=postgresql://davart:davart@localhost:5432/davart?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=davart-dev-master-key

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=davart
S3_SECRET_KEY=davartsecret
S3_BUCKET=davart
S3_REGION=us-east-1

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS (Sprint 1)
SMS_PROVIDER=mock
SMS_API_KEY=

# App
PORT=3000
NODE_ENV=development
