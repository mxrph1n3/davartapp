generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  created
  confirmed
  assembling
  shipping
  delivered
}

enum ProjectStatus {
  brief_filling
  in_progress
  completed
  archived
}

enum DocumentType {
  contract
  pdf
  dwg
  specification
  invoice
}

enum ChatType {
  project
  personal
  support
}

enum UserRole {
  client
  designer
  complectator
  admin
}

enum MessageType {
  text
  image
  file
  product
  voice
}

enum ProjectMemberRole {
  owner
  member
  viewer
}

model User {
  id                   String            @id @default(uuid())
  phone                String            @unique
  name                 String?
  email                String?
  role                 UserRole          @default(client)
  notificationsEnabled Boolean           @default(true) @map("notifications_enabled")
  birthDate            DateTime?         @map("birth_date") @db.Date
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  refreshTokens        RefreshToken[]
  favorites            Favorite[]
  orders               Order[]
  clientProjects       Project[]         @relation("ClientProjects")
  designerProjects     Project[]         @relation("DesignerProjects")
  managerProjects      Project[]         @relation("ManagerProjects")
  surveyorProjects     Project[]         @relation("SurveyorProjects")
  projectMemberships   ProjectMember[]
  chatParticipants     ChatParticipant[]
  sentMessages         Message[]         @relation("SentMessages")
  addresses            Address[]
  fcmTokens            FcmToken[]
  staffAuditsAsActor   StaffAuditLog[]   @relation("StaffAuditActor")
  staffAuditsAsClient  StaffAuditLog[]   @relation("StaffAuditClient")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("brands")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  imageUrl  String?   @map("image_url")
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  description     String?
  sku             String             @unique
  supplierSku     String?            @unique @map("supplier_sku")
  collectionSlug  String?            @map("collection_slug")
  sourceUrl       String?            @map("source_url")
  price           Decimal            @db.Decimal(12, 2)
  compareAtPrice  Decimal?           @map("compare_at_price") @db.Decimal(12, 2)
  imageUrl        String?            @map("image_url")
  inStock         Boolean            @default(true) @map("in_stock")
  isPopular       Boolean            @default(false) @map("is_popular")
  categoryId      String             @map("category_id")
  brandId         String?            @map("brand_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  category        Category           @relation(fields: [categoryId], references: [id])
  brand           Brand?             @relation(fields: [brandId], references: [id])
  attributes      ProductAttribute[]
  cartItems       CartItem[]
  favorites       Favorite[]
  orderItems      OrderItem[]
  messages        Message[]

  @@index([categoryId])
  @@index([brandId])
  @@index([createdAt])
  @@index([collectionSlug])
  @@map("products")
}

model ProductAttribute {
  id        String  @id @default(uuid())
  key       String
  value     String
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

model Cart {
  id        String     @id @default(uuid())
  projectId String     @unique @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id              String    @id @default(uuid())
  cartId          String    @map("cart_id")
  productId       String    @map("product_id")
  quantity        Int       @default(1)
  lockedAt        DateTime? @map("locked_at")
  lockedByOrderId String?   @map("locked_by_order_id")
  cart            Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id])
  lockedByOrder   Order?    @relation(fields: [lockedByOrderId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([lockedByOrderId])
  @@map("cart_items")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

model Order {
  id          String               @id @default(uuid())
  userId      String               @map("user_id")
  projectId   String?              @map("project_id")
  status      OrderStatus          @default(created)
  address     String
  comment     String?
  totalAmount Decimal              @map("total_amount") @db.Decimal(12, 2)
  user        User                 @relation(fields: [userId], references: [id])
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  statusHistory OrderStatusHistory[]
  lockedCartItems CartItem[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  name      String
  sku       String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_status_history")
}

model Project {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  designerId String?       @map("designer_id")
  managerId  String?       @map("manager_id")
  surveyorId String?       @map("surveyor_id")
  name       String
  address    String?
  area       Float?
  style      String?
  objectType String?       @map("object_type")
  startDate  DateTime?     @map("start_date")
  status     ProjectStatus @default(brief_filling)
  isShowcase Boolean       @default(false) @map("is_showcase")
  user       User          @relation("ClientProjects", fields: [userId], references: [id], onDelete: Cascade)
  designer   User?         @relation("DesignerProjects", fields: [designerId], references: [id], onDelete: SetNull)
  manager    User?         @relation("ManagerProjects", fields: [managerId], references: [id], onDelete: SetNull)
  surveyor   User?         @relation("SurveyorProjects", fields: [surveyorId], references: [id], onDelete: SetNull)
  brief      Brief?
  documents  Document[]
  chats      Chat[]
  members    ProjectMember[]
  cart       Cart?
  orders     Order[]
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([designerId])
  @@index([managerId])
  @@index([surveyorId])
  @@index([isShowcase])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  userId    String            @map("user_id")
  role      ProjectMemberRole @default(member)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Brief {
  id        String    @id @default(uuid())
  projectId String    @unique @map("project_id")
  style     String?
  budget    Decimal?  @db.Decimal(12, 2)
  wishes    String?
  rooms     Json?
  answers   Json?
  isLocked  Boolean   @default(false) @map("is_locked")
  lockedAt  DateTime? @map("locked_at")
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("briefs")
}

model Document {
  id         String       @id @default(uuid())
  projectId  String       @map("project_id")
  type       DocumentType
  name       String
  storageKey String       @map("storage_key")
  mimeType   String?      @map("mime_type")
  size       Int?
  uploadedAt DateTime     @default(now()) @map("uploaded_at")
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("documents")
}

model Chat {
  id           String            @id @default(uuid())
  type         ChatType
  projectId    String?           @map("project_id")
  title        String?
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     Message[]
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("chats")
}

model ChatParticipant {
  id          String    @id @default(uuid())
  chatId      String    @map("chat_id")
  userId      String    @map("user_id")
  lastReadAt  DateTime? @map("last_read_at")
  unreadCount Int       @default(0) @map("unread_count")
  chat        Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model Message {
  id             String      @id @default(uuid())
  chatId         String      @map("chat_id")
  senderId       String      @map("sender_id")
  type           MessageType
  content        String?
  attachmentKey  String?     @map("attachment_key")
  attachmentName String?     @map("attachment_name")
  attachmentMime String?     @map("attachment_mime")
  productId      String?     @map("product_id")
  chat           Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender         User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([chatId, createdAt])
  @@map("messages")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String?
  city      String
  street    String
  building  String
  apartment String?
  isDefault Boolean  @default(false) @map("is_default")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

model FcmToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("fcm_tokens")
}

model StaffAuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  clientId  String   @map("client_id")
  action    String
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")
  actor     User     @relation("StaffAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  client    User     @relation("StaffAuditClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt])
  @@map("staff_audit_logs")
}
