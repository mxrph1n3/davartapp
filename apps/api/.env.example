MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=change-me-meilisearch-master-key

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
REDIS_URL=redis://localhost:6379
SMS_PROVIDER=mock
# SMS_PROVIDER=smsru
# SMSRU_API_ID=
# SMS_PROVIDER=p1sms
# P1SMS_API_KEY=
# P1SMS_BOT_USERNAME=your_p1sms_bot
# P1SMS_CHANNEL=telegram

# Dev-only endpoints (seed-demo, catalog reindex). Default deny — set true locally.
ALLOW_DEV_ENDPOINTS=true

# Admin mutations (PATCH /orders/:id/status, POST /projects/:id/start-work)
# Send header: x-admin-secret: <value>
ADMIN_API_SECRET=change-me-admin-api-secret

# Database
DATABASE_URL=postgresql://davart:davart@localhost:5432/davart?schema=public
PORT=3000
NODE_ENV=development

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=davart
S3_SECRET_KEY=davartsecret
S3_BUCKET=davart
S3_REGION=us-east-1
# Public base for catalog images (path-style). Override for device testing, e.g. http://192.168.x.x:9000/davart
S3_PUBLIC_BASE_URL=http://localhost:9000/davart

# Push (optional — без ключа работает mock-режим)
# FCM_SERVER_KEY=

# Telegram: токен BotFather + id группы менеджеров (отрицательный, вида -100…)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_MANAGERS_CHAT_ID=
# CRM web (кнопка «Открыть заказ» в Telegram). Локально: http://localhost:3001
# CRM_WEB_URL=http://localhost:3001
# Публичный URL CRM, если CRM_WEB_URL не задан.
# APP_PUBLIC_URL=https://crm.davart.ru

# CORS (comma-separated). Required in production.
# CORS_ORIGIN=https://crm.davart.ru

# Monitoring (optional)
# SENTRY_DSN=
