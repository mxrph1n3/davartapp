MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=change-me-meilisearch-master-key

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
REDIS_URL=redis://localhost:6379
SMS_PROVIDER=mock
# Demo / App Review login (no SMS). Comma-separated E.164 phones + fixed 4-digit code.
# AUTH_TEST_PHONES=+70000000000
# AUTH_TEST_CODE=
# Official Telegram Gateway OTP (recommended):
# SMS_PROVIDER=telegram
# TELEGRAM_GATEWAY_TOKEN=from https://gateway.telegram.org
# TELEGRAM_GATEWAY_SENDER=optional_verified_channel_username
# SMS_FALLBACK_PROVIDER=smsru
# SMS_FALLBACK_PROVIDER=targetsms
# SMS_PROVIDER=smsru
# SMSRU_API_ID=
# SMS_PROVIDER=targetsms
# TARGETSMS_LOGIN=
# TARGETSMS_PASSWORD=
# TARGETSMS_SENDER=DAVart.ru
# SMS_PROVIDER=p1sms
# P1SMS_API_KEY=
# P1SMS_BOT_USERNAME=your_p1sms_bot
# P1SMS_CHANNEL=telegram

# Dev-only endpoints (seed-demo, catalog reindex). Default deny — set true locally.
ALLOW_DEV_ENDPOINTS=true

# Admin mutations (PATCH /orders/:id/status, POST /projects/:id/start-work)
# Send header: x-admin-secret: <value>
ADMIN_API_SECRET=change-me-admin-api-secret

# Database
DATABASE_URL=postgresql://davart:davart@localhost:5432/davart?schema=public
PORT=3000
NODE_ENV=development

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=davart
S3_SECRET_KEY=davartsecret
S3_BUCKET=davart
S3_REGION=us-east-1
# Public base for catalog images (path-style). Override for device testing, e.g. http://192.168.x.x:9000/davart
S3_PUBLIC_BASE_URL=http://localhost:9000/davart

# iOS push (Apple Developer → Keys → Apple Push Notifications service, файл AuthKey_XXXX.p8).
# Без ключа баннер на закрытом iPhone не уходит. Пока приложение открыто, баннер показывает само приложение.
# APNS_KEY_ID=
# APNS_TEAM_ID=C7968P6K9R
# APNS_BUNDLE_ID=com.davart.app
# APNS_KEY_PATH=/etc/davart/AuthKey.p8
# Либо сам ключ одной строкой, переносы как \n:
# APNS_PRIVATE_KEY=
# FCM_SERVER_KEY=

# Telegram: токен BotFather + id группы менеджеров (отрицательный, вида -100…)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_MANAGERS_CHAT_ID=
# CRM web (кнопка «Открыть заказ» в Telegram). Локально: http://localhost:3001
# CRM_WEB_URL=http://localhost:3001
# Публичный URL CRM, если CRM_WEB_URL не задан.
# APP_PUBLIC_URL=https://crm.davart.ru

# CORS (comma-separated). Required in production.
# CORS_ORIGIN=https://crm.davart.ru

# Monitoring (optional)
# SENTRY_DSN=
